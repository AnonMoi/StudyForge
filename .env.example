CLOUD_MODEL_API_KEY=replace-with-your-new-key
CLOUD_MODEL_ENABLED=false

DAILY_CLOUD_CALL_LIMIT=20
DAILY_COST_LIMIT=2.00
MAX_TOKENS_PER_REQUEST=12000
LOG_PROMPTS=false
REDACT_SENSITIVE_DATA=true
LEARNING_SCHEDULER_INTERVAL_SECONDS=60
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
