WEB_PUSH_TTL_SECONDS=3600
NATIVE_NOTIFICATIONS_ENABLED=false
CLOUD_SYNC_ENABLED=false
CLOUD_SYNC_PROVIDER=webdav
CLOUD_SYNC_URL=
CLOUD_SYNC_USERNAME=
CLOUD_SYNC_PASSWORD=
CLOUD_SYNC_PATH=learning-workstation/sync.json
CLOUD_SYNC_TIMEOUT_SECONDS=15
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4174,http://localhost:4174
API_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
MAX_REQUEST_BODY_BYTES=2000000
API_WORKERS=1
GITHUB_ENABLED=true
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TOKEN=
